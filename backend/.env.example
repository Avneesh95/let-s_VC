PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/chatapp
JWT_SECRET=replace_with_a_long_random_string
CLIENT_URL=http://localhost:5173
# For testing from a phone on the same WiFi, add your laptop's LAN IP too:
# CLIENT_URL=http://localhost:5173,http://192.168.1.42:5173

# Free tier at cloudinary.com — used for image uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Web Push (background call notifications). Generate a pair with:
#   npx web-push generate-vapid-keys
# Keep the same pair across deploys — rotating it invalidates every
# existing browser subscription and users would need to re-enable the
# "ring when app is closed" toggle. If left unset, the app still works
# fine — that one feature just silently stays off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=you@example.com
