PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/chat_app
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:5173

# Optional: Add mobile/LAN IP for local phone testing:
# CLIENT_URL=http://localhost:5173,http://192.168.1.50:5173

# Cloudinary for image and avatar uploads (free tier at cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional: Web Push (background notifications). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=you@example.com
