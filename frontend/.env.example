# URL of the deployed backend (no trailing slash)
VITE_API_URL=http://localhost:5000

# Note: no VITE_SOCKET_URL or VITE_CLOUDINARY_CLOUD_NAME here on purpose —
# this app's Socket.IO client connects to the same origin as VITE_API_URL
# (see src/context/SocketContext.jsx), and image uploads go through the
# backend's /api/upload route rather than uploading to Cloudinary directly
# from the browser (see backend/routes/upload.js), so there's no Cloudinary
# config the frontend itself needs to know about.
